rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Isolated user-profile document: Only the authenticated user can read or write their own profile
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Isolated user interactions (journal entries, reflections, and Gemini responses)
    // Strictly isolates reads and writes to the authenticated owner. No cross-user access allowed.
    match /users/{userId}/interactions/{interactionId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Default deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
